# Committed on purpose: this file is the authoritative list of every variable
# the app reads. It must never contain a real value.

# ===========================================================================
# BUILD-TIME
# Read when `next build` runs, NOT when the server starts, because the routes
# that use them are statically generated. Staging and production therefore
# need separate builds.
# ===========================================================================

# "production" makes robots.txt allow indexing. Anything else (or unset)
# emits `Disallow: /`, which is what staging must serve.
SITE_ENV=

# Canonical origin, used for canonical URLs, sitemap entries, OG tags and
# JSON-LD @id values. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ===========================================================================
# RUNTIME — EMAIL
#
# Validated at boot by src/instrumentation.ts. The rule is:
#   nothing set      -> console transport + a warning (local development)
#   partially set    -> the server REFUSES TO START, naming the missing key
#   fully set        -> used
#
# The dangerous state is a partial configuration: the app looks healthy,
# accepts enquiries, and silently fails to deliver them. Failing the boot
# means the deploy health check catches it and rolls back instead.
# ===========================================================================

# --- Option A: SMTP via your own mailbox (default; no recurring cost) ------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional. Defaults to true on port 465 (implicit TLS), false otherwise
# (STARTTLS). Only set this if your provider is unusual.
SMTP_SECURE=

# --- Option B: Resend (used instead of SMTP when this key is present) ------
# The escape hatch if the VPS IP turns out to have poor sending reputation.
# RESEND_API_KEY=

# --- Required by both ------------------------------------------------------
# MUST be an address on a domain you control. Sending FROM the enquirer's
# address fails DMARC and lands in spam — the most common cause of
# "the contact form doesn't work".
MAIL_FROM=
MAIL_FROM_NAME=SolutionMines

# Where enquiry notifications go. Reply-To is set to the enquirer, so hitting
# reply in your mail client answers them directly.
CONTACT_RECIPIENT_EMAIL=

# ===========================================================================
# RUNTIME — OPTIONAL
# ===========================================================================

# Reported by /api/health so a deploy can verify the running container is the
# image it just shipped, rather than the previous one.
# GIT_COMMIT_SHA=

# Spam prevention. While unset, verifyHuman() is a no-op and the form relies
# on the honeypot, time trap and rate limiter alone — which is the
# recommended starting position.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
