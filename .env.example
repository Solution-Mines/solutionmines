# Committed on purpose: this file is the authoritative list of every variable
# the app reads. It must never contain a real value.

# ---------------------------------------------------------------------------
# BUILD-TIME. These are read when `next build` runs, NOT when the server
# starts, because the routes that use them are statically generated. Staging
# and production therefore need separate builds.
# ---------------------------------------------------------------------------

# "production" makes robots.txt allow indexing. Anything else (or unset)
# emits `Disallow: /`, which is what staging must serve.
SITE_ENV=

# Canonical origin, used for canonical URLs, sitemap entries, OG tags and
# JSON-LD @id values. No trailing slash.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# RUNTIME. Not yet wired up — the email transport currently logs to stdout.
# Validate these at startup and fail fast: a missing SMTP_PASSWORD should
# crash the container at boot, where the deploy health check catches it and
# rolls back, rather than silently breaking the contact form a week later.
# ---------------------------------------------------------------------------

# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# CONTACT_RECIPIENT_EMAIL=

# Alternative transport. If set, used instead of SMTP.
# RESEND_API_KEY=

# Spam prevention. While unset, verifyHuman() is a no-op and the form relies
# on the honeypot, time trap and rate limiter alone.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
